<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>HajimiPet</AssemblyName>
    <RootNamespace>HajimiPet</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>HajimiPet</Company>
    <Product>HajimiPet</Product>
    <AssemblyTitle>HajimiPet</AssemblyTitle>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 让现代 SDK/Roslyn 也能编译 .NET Framework 4.8 目标 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 运行时图层：躯干 + 双脚 + 阴影 + 托盘/图标 -->
    <EmbeddedResource Include="Assets\pet-torso.png" />
    <EmbeddedResource Include="Assets\pet-leg-left.png" />
    <EmbeddedResource Include="Assets\pet-leg-right.png" />
    <EmbeddedResource Include="Assets\pet-shadow.png" />
    <EmbeddedResource Include="Assets\tray.png" />
    <EmbeddedResource Include="Assets\pet.ico" Condition="Exists('Assets\pet.ico')" />
  </ItemGroup>

</Project>
