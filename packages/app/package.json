{
  "name": "@hajimi/app",
  "version": "1.0.0",
  "private": true,
  "description": "哈基米桌宠桌面应用（Electron）",
  "main": "dist/main/main/index.js",
  "author": "xtf666666-student",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=dist/main/preload/index.js",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "electron .",
    "selftest": "npm run build && node scripts/selftest.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.7",
    "electron": "33.4.11",
    "esbuild": "^0.25.12",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "build": {
    "appId": "com.hajimi.desktoppet",
    "productName": "HajimiDesktopPet",
    "copyright": "Copyright © 2026 xtf666666-student",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "asar": true,
    "compression": "normal",
    "files": [
      "dist/**/*",
      "assets/hajimi.png",
      "assets/tray.png",
      "assets/icon.png",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main/main/index.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "哈基米桌宠",
      "installerLanguages": [
        "zh_CN"
      ],
      "artifactName": "HajimiDesktopPet-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "HajimiDesktopPet-Portable-${version}-${arch}.${ext}"
    }
  }
}
